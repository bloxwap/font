{
  "name": "@bloxwap/font-native-kr",
  "version": "0.1.3",
  "description": "Static native TTF faces and typed Metro asset maps for BloxwapSansKR, BloxwapMonoKR.",
  "type": "commonjs",
  "license": "OFL-1.1",
  "author": "Bloxwap",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bloxwap/font.git",
    "directory": "packages/native/kr"
  },
  "files": [
    "BloxwapSansKR",
    "BloxwapMonoKR",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./BloxwapSansKR": {
      "types": "./BloxwapSansKR/index.d.ts",
      "default": "./BloxwapSansKR/index.js"
    },
    "./BloxwapMonoKR": {
      "types": "./BloxwapMonoKR/index.d.ts",
      "default": "./BloxwapMonoKR/index.js"
    },
    "./assets/*": "./*"
  },
  "scripts": {
    "prepack": "node ../../npm/scripts/build.mjs"
  }
}

{
  "name": "@bloxwap/font-native-jp",
  "version": "0.1.3",
  "description": "Static native TTF faces and typed Metro asset maps for BloxwapSansJP, BloxwapMonoJP.",
  "type": "commonjs",
  "license": "OFL-1.1",
  "author": "Bloxwap",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bloxwap/font.git",
    "directory": "packages/native/jp"
  },
  "files": [
    "BloxwapSansJP",
    "BloxwapMonoJP",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./BloxwapSansJP": {
      "types": "./BloxwapSansJP/index.d.ts",
      "default": "./BloxwapSansJP/index.js"
    },
    "./BloxwapMonoJP": {
      "types": "./BloxwapMonoJP/index.d.ts",
      "default": "./BloxwapMonoJP/index.js"
    },
    "./assets/*": "./*"
  },
  "scripts": {
    "prepack": "node ../../npm/scripts/build.mjs"
  }
}

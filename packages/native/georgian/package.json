{
  "name": "@bloxwap/font-native-georgian",
  "version": "0.1.3",
  "description": "Static native TTF faces and typed Metro asset maps for BloxwapSansGeorgian, BloxwapMonoGeorgian.",
  "type": "commonjs",
  "license": "OFL-1.1",
  "author": "Bloxwap",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bloxwap/font.git",
    "directory": "packages/native/georgian"
  },
  "files": [
    "BloxwapSansGeorgian",
    "BloxwapMonoGeorgian",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./BloxwapSansGeorgian": {
      "types": "./BloxwapSansGeorgian/index.d.ts",
      "default": "./BloxwapSansGeorgian/index.js"
    },
    "./BloxwapMonoGeorgian": {
      "types": "./BloxwapMonoGeorgian/index.d.ts",
      "default": "./BloxwapMonoGeorgian/index.js"
    },
    "./assets/*": "./*"
  },
  "scripts": {
    "prepack": "node ../../npm/scripts/build.mjs"
  }
}

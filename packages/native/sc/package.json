{
  "name": "@bloxwap/font-native-sc",
  "version": "0.1.3",
  "description": "Static native TTF faces and typed Metro asset maps for BloxwapSansSC, BloxwapMonoSC.",
  "type": "commonjs",
  "license": "OFL-1.1",
  "author": "Bloxwap",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bloxwap/font.git",
    "directory": "packages/native/sc"
  },
  "files": [
    "BloxwapSansSC",
    "BloxwapMonoSC",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./BloxwapSansSC": {
      "types": "./BloxwapSansSC/index.d.ts",
      "default": "./BloxwapSansSC/index.js"
    },
    "./BloxwapMonoSC": {
      "types": "./BloxwapMonoSC/index.d.ts",
      "default": "./BloxwapMonoSC/index.js"
    },
    "./assets/*": "./*"
  },
  "scripts": {
    "prepack": "node ../../npm/scripts/build.mjs"
  }
}

{
  "name": "@bloxwap/font-native-armenian",
  "version": "0.1.3",
  "description": "Static native TTF faces and typed Metro asset maps for BloxwapSansArmenian, BloxwapMonoArmenian.",
  "type": "commonjs",
  "license": "OFL-1.1",
  "author": "Bloxwap",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bloxwap/font.git",
    "directory": "packages/native/armenian"
  },
  "files": [
    "BloxwapSansArmenian",
    "BloxwapMonoArmenian",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./BloxwapSansArmenian": {
      "types": "./BloxwapSansArmenian/index.d.ts",
      "default": "./BloxwapSansArmenian/index.js"
    },
    "./BloxwapMonoArmenian": {
      "types": "./BloxwapMonoArmenian/index.d.ts",
      "default": "./BloxwapMonoArmenian/index.js"
    },
    "./assets/*": "./*"
  },
  "scripts": {
    "prepack": "node ../../npm/scripts/build.mjs"
  }
}

{
  "name": "@bloxwap/font-native",
  "version": "0.1.3",
  "description": "Static native TTF faces and typed Metro asset maps for BloxwapSans, BloxwapMono, BloxwapPixel.",
  "type": "commonjs",
  "license": "OFL-1.1",
  "author": "Bloxwap",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bloxwap/font.git",
    "directory": "packages/native/core"
  },
  "files": [
    "BloxwapSans",
    "BloxwapMono",
    "BloxwapPixel",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./BloxwapSans": {
      "types": "./BloxwapSans/index.d.ts",
      "default": "./BloxwapSans/index.js"
    },
    "./BloxwapMono": {
      "types": "./BloxwapMono/index.d.ts",
      "default": "./BloxwapMono/index.js"
    },
    "./BloxwapPixel": {
      "types": "./BloxwapPixel/index.d.ts",
      "default": "./BloxwapPixel/index.js"
    },
    "./assets/*": "./*"
  },
  "scripts": {
    "prepack": "node ../../npm/scripts/build.mjs"
  }
}

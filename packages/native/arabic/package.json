{
  "name": "@bloxwap/font-native-arabic",
  "version": "0.1.3",
  "description": "Static native TTF faces and typed Metro asset maps for BloxwapSansArabic, BloxwapMonoArabic.",
  "type": "commonjs",
  "license": "OFL-1.1",
  "author": "Bloxwap",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bloxwap/font.git",
    "directory": "packages/native/arabic"
  },
  "files": [
    "BloxwapSansArabic",
    "BloxwapMonoArabic",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./BloxwapSansArabic": {
      "types": "./BloxwapSansArabic/index.d.ts",
      "default": "./BloxwapSansArabic/index.js"
    },
    "./BloxwapMonoArabic": {
      "types": "./BloxwapMonoArabic/index.d.ts",
      "default": "./BloxwapMonoArabic/index.js"
    },
    "./assets/*": "./*"
  },
  "scripts": {
    "prepack": "node ../../npm/scripts/build.mjs"
  }
}

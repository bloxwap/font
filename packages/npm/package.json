{
  "name": "@bloxwap/font",
  "version": "0.1.4",
  "description": "Bloxwap Sans, Mono and Pixel: variable web fonts and native TTFs for every script in one package. Selective CSS, Next.js loaders and typed Metro asset maps.",
  "type": "module",
  "license": "OFL-1.1",
  "author": "Bloxwap",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bloxwap/font.git",
    "directory": "packages/npm"
  },
  "homepage": "https://bloxwap.github.io/font/",
  "bugs": {
    "url": "https://github.com/bloxwap/font/issues"
  },
  "keywords": [
    "font",
    "fonts",
    "typeface",
    "variable-font",
    "woff2",
    "next-font",
    "nextjs",
    "monospace",
    "pixel-font",
    "cjk",
    "arabic",
    "hebrew"
  ],
  "sideEffects": [
    "*.css",
    "./src/*.js"
  ],
  "style": "./bloxwap-font.css",
  "exports": {
    ".": {
      "types": "./src/css.d.ts",
      "default": "./bloxwap-font.css"
    },
    "./css": {
      "types": "./src/css.d.ts",
      "default": "./bloxwap-font.css"
    },
    "./bloxwap-font.css": "./bloxwap-font.css",
    "./sans": {
      "types": "./src/sans.d.ts",
      "default": "./src/sans.js"
    },
    "./mono": {
      "types": "./src/mono.d.ts",
      "default": "./src/mono.js"
    },
    "./pixel": {
      "types": "./src/pixel.d.ts",
      "default": "./src/pixel.js"
    },
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json",
    "./css/*": "./css/*.css",
    "./manifest": {
      "types": "./src/manifest.d.ts",
      "default": "./manifest.json"
    },
    "./native/*": {
      "types": "./native/*/index.d.ts",
      "default": "./native/*/index.js"
    },
    "./native/assets/*": "./native/*"
  },
  "files": [
    "src",
    "fonts",
    "bloxwap-font.css",
    "sans-scripts.css",
    "mono-scripts.css",
    "LICENSE",
    "README.md",
    "css",
    "manifest.json",
    "native"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "test": "node --test scripts/package.test.mjs scripts/check-publish-auth.test.mjs && ${FONT_PYTHON:-python3} scripts/test_faces.py"
  },
  "peerDependencies": {
    "next": ">=15.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}

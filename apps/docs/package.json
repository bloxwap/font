{
  "name": "@bloxwap/font-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/check-data.ts && fumadocs-mdx && next dev --port 3904",
    "build": "bun run scripts/check-hig-vendor.ts && bun run scripts/check-data.ts && fumadocs-mdx && next typegen && node ../../scripts/typecheck.mjs && next build && bun run scripts/check-export.ts",
    "preview": "bun run scripts/preview.ts",
    "check": "fumadocs-mdx && next typegen && node ../../scripts/typecheck.mjs",
    "typecheck:tsc": "fumadocs-mdx && next typegen && tsc --noEmit",
    "data": "cd ../../packages/font && .venv/bin/python tools/site_data.py",
    "smoke": "playwright test",
    "test:unit": "bun test lib/glyph-text.test.ts components/docs/in-development.test.tsx",
    "test:accessibility": "bun test lib/glyph-text.test.ts && playwright test accessibility.spec.ts unicode.spec.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@bloxwap/hig-contracts": "file:../../vendor/bloxwap-hig/bloxwap-hig-contracts-0.1.0-candidate.sha7c67a07c.tgz",
    "@bloxwap/hig-react": "file:../../vendor/bloxwap-hig/bloxwap-hig-react-0.1.0-candidate.sha7c67a07c.tgz",
    "@bloxwap/hig-tokens": "file:../../vendor/bloxwap-hig/bloxwap-hig-tokens-0.1.0-candidate.sha7c67a07c.tgz",
    "@number-flow/react": "0.6.2",
    "fumadocs-core": "16.17.7",
    "fumadocs-mdx": "15.4.9",
    "fumadocs-ui": "16.17.7",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "10",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4.3.3",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "6.0.3"
  }
}
